RGW_ENDPOINT_URL=http://10.0.0.10:8080
RGW_ACCESS_KEY=change-me
RGW_SECRET_KEY=change-me
RGW_DEFAULT_BUCKET=test-data
RGW_ALLOWED_BUCKETS=test-data
RGW_STREAM_PREFIX_ROOT=console-jobs/
RGW_AFFECTED_POOLS=
RGW_ADMIN_MODE=current_s3_identity

# Native Python processes connect through the host loopback address.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/rgw_console

# Docker containers reach PostgreSQL installed on the host through this name.
# URL-encode reserved characters in the password before putting it in a URL.
DOCKER_DATABASE_URL=postgresql://postgres:change-me@host.docker.internal:5432/rgw_console

# Native paths are resolved from code/rgw-console. Compose overrides both with /data paths.
CORPUS_MIXED_ROOT=../data/mix-file-corpus
CORPUS_SIZE_ROOT=../data/size-file-corpus
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Capacity starts in observe-only mode until read-only Ceph inventory is complete.
CAPACITY_OBSERVE_ONLY=true
CAPACITY_HARD_CEILING_RATIO=0.70
CAPACITY_ADMISSION_STOP_RATIO=0.68
CAPACITY_THROTTLE_START_RATIO=0.67
CAPACITY_RESUME_RATIO=0.67
CAPACITY_COLLECTOR_INTERVAL_SECONDS=2
CAPACITY_METRICS_MAX_AGE_SECONDS=5

# Performance Monitor always records console request I/O. Set source to
# prometheus only after verifying the Pacific mgr/prometheus endpoint and FSID.
PERFORMANCE_ENABLED=true
PERFORMANCE_SOURCE=application_only
PERFORMANCE_PROMETHEUS_URL=
PERFORMANCE_PROMETHEUS_BEARER_TOKEN=
PERFORMANCE_COLLECTOR_INTERVAL_SECONDS=15
PERFORMANCE_CURRENT_WINDOW_SECONDS=15
PERFORMANCE_STALE_AFTER_SECONDS=45
PERFORMANCE_RAW_RETENTION_HOURS=24
PERFORMANCE_ROLLUP_RETENTION_DAYS=30

# Leave these unset until calibrated from the actual lab. Enforcement fails closed.
CAPACITY_FIXED_METADATA_BYTES_PER_OBJECT=
CAPACITY_SAFETY_MARGIN_MIN_BYTES_PER_OSD=

# Node SSH executor/RBD scope. Mutation remains fail-closed until every identity,
# secret, SSH target, and allowlist value is provisioned.
CEPH_EXPECTED_FSID=
CEPH_CLUSTER_NAME=ceph
RBD_EXECUTOR_URL=http://rbd-console:3001
# Generate a random value of at least 32 characters; never commit the real value.
RBD_EXECUTOR_TOKEN=
RBD_EXECUTOR_TIMEOUT_SECONDS=35
RBD_VALIDATION_TIMEOUT_SECONDS=300
RBD_HOST=
RBD_SSH_PORT=22
RBD_SSH_USER=
# Host path mounted read-only into the executor container.
RBD_SSH_PRIVATE_KEY_FILE=./runtime/id_rsa
RBD_SSH_CONNECT_TIMEOUT_MS=10000
RBD_COMMAND_TIMEOUT_MS=30000
RBD_MAX_OUTPUT_BYTES=5242880
RBD_ALLOWED_POOLS=rbd-lab
RBD_ALLOWED_NAMESPACES=default
RBD_POOL=rbd-lab
RBD_IMAGE_PREFIX=lab-
RBD_MOUNT_ROOT=/mnt/rbd
RBD_ACTION_LEASE_SECONDS=120
RBD_ACTION_POLL_SECONDS=1
RBD_FILE_PREVIEW_MAX_BYTES=5242880
RBD_FILE_UPLOAD_MAX_BYTES=17179869184
RBD_ALLOWED_PREVIEW_MIME=text/plain,text/markdown,text/yaml,text/csv,application/json,application/pdf,image/jpeg,image/png,image/gif,image/webp,image/svg+xml
RBD_TERMINAL_TICKET_TTL_MS=30000
RBD_TERMINAL_IDLE_TIMEOUT_MS=900000
RBD_TERMINAL_MAX_SESSION_MS=3600000

# Optional values used only with: docker compose --profile bundled-db ...
BUNDLED_POSTGRES_USER=rgw
BUNDLED_POSTGRES_PASSWORD=change-me
BUNDLED_POSTGRES_DB=rgw_console
