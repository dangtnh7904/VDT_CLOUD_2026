# Linux host to SSH into (Ceph node with rbd CLI + keyring)
RBD_HOST=ceph-admin.example.invalid
RBD_SSH_PORT=22
RBD_SSH_USER=root
RBD_SSH_KEY_PATH=~/.ssh/id_rsa
# RBD_SSH_PASSWORD=           # optional; prefer key auth

# Ceph scope
RBD_POOL=rbd-lab
RBD_MOUNT_ROOT=/mnt/rbd
RBD_IMAGE_PREFIX=lab-
CEPH_EXPECTED_FSID=

# Timeouts
RBD_COMMAND_TIMEOUT_MS=15000
OSD_INFO_COLLECTOR_PATH=/opt/storage-lab/collect_osd.py
OSD_INFO_COLLECTOR_COMMAND_TIMEOUT_SECONDS=45
OSD_INFO_COLLECTOR_TIMEOUT_MS=300000
OSD_INFO_COLLECTOR_MAX_OUTPUT_BYTES=67108864
UPGRADE_ALLOWED_OSDS=0

# Web server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Run the reader as a restricted SSH account, using existing sudo -n ceph rules.
OSD_INFO_COLLECTOR_RUN_AS_SSH_USER=false
