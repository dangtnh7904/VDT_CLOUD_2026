# Linux host to SSH into (Ceph node with rbd CLI + keyring)
RBD_HOST=10.20.20.12
RBD_SSH_PORT=22
RBD_SSH_USER=root
RBD_SSH_KEY_PATH=~/.ssh/id_rsa
# RBD_SSH_PASSWORD=           # optional; prefer key auth

# Ceph scope
RBD_POOL=rbd-lab
RBD_MOUNT_ROOT=/mnt/rbd
RBD_IMAGE_PREFIX=lab-
CEPH_EXPECTED_FSID=17c77e12-a16a-11f1-838e-cf68e9c001d8

# Timeouts
RBD_COMMAND_TIMEOUT_MS=15000

# Web server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
