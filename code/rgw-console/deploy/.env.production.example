# Non-secret runtime configuration. Use a separate deployment directory.
COMPOSE_PROJECT_NAME=storage-lab-console-production
STORAGE_LAB_CONSOLE_IMAGE=dang7904/storage-lab-console@sha256:49f5284d27fd4defe2e2804e3b4eb06eaa3ac19352026622de3eae6c417fbe1f
POSTGRES_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
INGRESS_IMAGE=nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
RELEASE_PULL_POLICY=never
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_HTTPS_PORT=8443
APP_INSTANCE_ID=storage-lab-console-production
CONSOLE_AUTH_USERNAME=console-admin
CORS_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# Enable only after remote FSID/key/collector/scope validation.
FEATURE_UPGRADE=false
CLUSTER_ID=production-local-test
CLUSTER_PROFILE_REVISION=production-local-test-v1
POLICY_REVISION=readonly-v1
CEPH_EXPECTED_FSID=
RBD_HOST=
RBD_SSH_PORT=22
RBD_SSH_USER=storage-lab
UPGRADE_ALLOWED_OSDS=
UPGRADE_ALLOWED_HOSTS=
UPGRADE_ALLOWED_POOLS=
UPGRADE_ALLOWED_DEVICE_CLASSES=
RBD_ALLOWED_POOLS=
RBD_ALLOWED_NAMESPACES=
OSD_INFO_COLLECTOR_PATH=/opt/storage-lab/collect_osd.py
OSD_INFO_COLLECTOR_RUN_AS_SSH_USER=true
PERFORMANCE_ENABLED=true
PERFORMANCE_SOURCE=application_only
TELEMETRY_PROVIDER=disabled
EVIDENCE_RETENTION_DAYS=30
