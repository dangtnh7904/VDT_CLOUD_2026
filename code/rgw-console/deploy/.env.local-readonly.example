# Localhost read-only configuration; plain NAME=value lines, no shell quotes.
# Copy to .env.local-readonly and fill the verified cluster values.
# Keep passwords, executor token, and SSH private key in separate secret files.
APP_ENV=lab
EXECUTION_ENVIRONMENT=lab
CONSOLE_READ_ONLY=true
FEATURE_UPGRADE=true
FEATURE_LAB=false
FEATURE_LEGACY_RGW=false
FEATURE_LEGACY_RBD=false
UPGRADE_MUTATIONS_ENABLED=false
CAPACITY_OBSERVE_ONLY=true
CLUSTER_ID=your-cluster
CLUSTER_CONFIG_PATH=/etc/storage-lab-console/profiles/local-lab-readonly.yaml
CEPH_EXPECTED_FSID=
RBD_HOST=
RBD_SSH_PORT=22
RBD_SSH_USER=storage-lab
RBD_SSH_KEY_PATH=/run/secrets/ssh_private_key
RBD_SSH_HOST_KEY_REQUIRED=true
RBD_SSH_HOST_KEY_SHA256=
RBD_SSH_CONNECT_TIMEOUT_MS=10000
CEPH_EXECUTOR_URL=http://storage-lab-console-local-executor:3001
RBD_EXECUTOR_URL=http://storage-lab-console-local-executor:3001
CEPH_EXECUTOR_TOKEN_FILE=/run/secrets/executor_token
RBD_EXECUTOR_TOKEN_FILE=/run/secrets/executor_token
DATABASE_URL_FILE=/run/secrets/database_url
EVIDENCE_ROOT=/var/lib/storage-lab-console/evidence
UPGRADE_ALLOWED_OSDS=
UPGRADE_ALLOWED_HOSTS=
UPGRADE_ALLOWED_POOLS=
UPGRADE_ALLOWED_DEVICE_CLASSES=
RBD_ALLOWED_POOLS=
RBD_ALLOWED_NAMESPACES=
OSD_INFO_COLLECTOR_PATH=/opt/storage-lab/collect_osd.py
OSD_INFO_COLLECTOR_RUN_AS_SSH_USER=true
PERFORMANCE_ENABLED=true
PERFORMANCE_SOURCE=application_only
TELEMETRY_PROVIDER=disabled
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
