# Non-secret paths only; replace all values before systemd enablement.
# No username/password/token/key CONTENT in this file.
CONSOLE_SOURCE=/opt/storage-lab-console-source/code/rgw-console
CONSOLE_DEPLOYMENT=/srv/storage-lab-console-production
CONSOLE_BACKUP_ROOT=/srv/backups/storage-lab-console
CONSOLE_BASE_URL=https://console.REPLACE_DOMAIN
CONSOLE_CA_FILE=/var/lib/storage-lab-console-monitor/approved-ca.pem
CONSOLE_ACCOUNTS_FILE=/var/lib/storage-lab-console-monitor/accounts.json
CONSOLE_ALERT_CONFIG=/var/lib/storage-lab-console-monitor/alert-config.json
CONSOLE_ALERT_STATE=/var/lib/storage-lab-console-monitor/alert-state.json
