# Copy to .env.release and replace every REPLACE_* value. Never commit that file.
# Use the exact application digest from the validated release manifest.
# 5.1.1-rc.1: Linux AMD64, read-only Ceph, not full production approval.
STORAGE_LAB_CONSOLE_IMAGE=dang7904/storage-lab-console@sha256:49f5284d27fd4defe2e2804e3b4eb06eaa3ac19352026622de3eae6c417fbe1f
POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_TESTED_64_HEX_DIGEST
RELEASE_PULL_POLICY=never
COMPOSE_PROJECT_NAME=storage-lab-console-lab-a

# Only the API is published. Keep loopback unless a trusted TLS/authentication
# ingress on the management network is explicitly configured.
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=8000

APP_ENV=lab
APP_INSTANCE_ID=storage-lab-console-lab-a
LAB_PROFILE=lab-a
CLUSTER_PROFILE_FILE=profiles/lab.yaml
CLUSTER_ID=lab-a
CLUSTER_PROFILE_REVISION=lab-a-v1
POLICY_REVISION=default-v1
EXECUTION_ENVIRONMENT=lab
LOG_LEVEL=INFO

# Start read-only. Live upgrade mutation remains disabled until its separate
# safety/live acceptance is complete and an operator changes the run policy.
FEATURE_UPGRADE=true
CONSOLE_READ_ONLY=true
FEATURE_LAB=false
FEATURE_LEGACY_RGW=false
FEATURE_LEGACY_RBD=false
UPGRADE_MUTATIONS_ENABLED=false

# These values must match the mounted profile and the remote preflight result.
CEPH_EXPECTED_FSID=11111111-2222-3333-4444-555555555555
CEPH_CLUSTER_NAME=ceph
CEPH_TRANSPORT=executor
RBD_HOST=ceph-admin.example.invalid
RBD_SSH_PORT=22
RBD_SSH_USER=storage-lab
RBD_SSH_CONNECT_TIMEOUT_MS=10000
RBD_COMMAND_TIMEOUT_MS=30000
RBD_MAX_OUTPUT_BYTES=5242880

# Fail-closed scope. Do not use wildcards.
UPGRADE_ALLOWED_OSDS=0,1,2
UPGRADE_ALLOWED_HOSTS=ceph-a,ceph-b,ceph-c
UPGRADE_ALLOWED_POOLS=rbd-lab
UPGRADE_ALLOWED_DEVICE_CLASSES=hdd
UPGRADE_INVENTORY_MAX_AGE_SECONDS=45
RBD_ALLOWED_POOLS=rbd-lab
RBD_ALLOWED_NAMESPACES=default
RBD_POOL=rbd-lab
RBD_IMAGE_PREFIX=lab-
RBD_MOUNT_ROOT=/mnt/rbd

OSD_INFO_COLLECTOR_PATH=/opt/storage-lab/collect_osd.py
# For a restricted SSH account, run the trusted helper as that account;
# only its fixed Ceph reads use the existing sudo -n ceph permission.
OSD_INFO_COLLECTOR_RUN_AS_SSH_USER=true
OSD_INFO_COLLECTOR_COMMAND_TIMEOUT_SECONDS=45
OSD_INFO_COLLECTOR_TIMEOUT_MS=300000
OSD_INFO_COLLECTOR_TIMEOUT_SECONDS=330
OSD_INFO_COLLECTOR_MAX_OUTPUT_BYTES=67108864

CAPACITY_OBSERVE_ONLY=true
CAPACITY_HARD_CEILING_RATIO=0.70
CAPACITY_ADMISSION_STOP_RATIO=0.68
CAPACITY_THROTTLE_START_RATIO=0.67
CAPACITY_RESUME_RATIO=0.67
CAPACITY_COLLECTOR_INTERVAL_SECONDS=2
CAPACITY_METRICS_MAX_AGE_SECONDS=5

PERFORMANCE_ENABLED=true
PERFORMANCE_SOURCE=application_only
PERFORMANCE_COLLECTOR_INTERVAL_SECONDS=15
PERFORMANCE_CURRENT_WINDOW_SECONDS=15
PERFORMANCE_STALE_AFTER_SECONDS=45
PERFORMANCE_RAW_RETENTION_HOURS=24
PERFORMANCE_ROLLUP_RETENTION_DAYS=30

TELEMETRY_PROVIDER=disabled
TELEMETRY_MAX_AGE_SECONDS=45
TELEMETRY_CLOCK_SKEW_MAX_SECONDS=5
LAB_VALIDATION_ENABLED=false
LAB_ALLOW_WRITE=false

EVIDENCE_RETENTION_DAYS=30
EVIDENCE_MAX_ARTIFACT_BYTES=67108864

# Optional bundled PostgreSQL profile. The password and the matching connection
# URL still live in separate mounted secret files, never in this env file.
BUNDLED_POSTGRES_USER=storage_lab_console
BUNDLED_POSTGRES_DB=storage_lab_console

DATABASE_URL_SECRET_FILE=./secrets/database_url
EXECUTOR_TOKEN_SECRET_FILE=./secrets/executor_token
SSH_PRIVATE_KEY_FILE=./secrets/ssh_private_key
SSH_KNOWN_HOSTS_FILE=./secrets/ssh_known_hosts
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password
