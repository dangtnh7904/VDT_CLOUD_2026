# Pin the exact lab cluster. Obtain it with the read-only command: ceph fsid
CEPH_EXPECTED_FSID=00000000-0000-0000-0000-000000000000
CEPH_CLUSTER_NAME=ceph
CEPH_CONF_PATH=/etc/ceph/ceph.conf
CEPH_KEYRING_PATH=/etc/ceph/ceph.client.admin.keyring
CEPH_CLIENT_ID=admin

CEPH_AGENT_SOCKET=/run/rgw-console/ceph-agent.sock
CEPH_AGENT_SOCKET_MODE=0660
CEPH_AGENT_SOCKET_GROUP=rgw-console
# Docker currently runs the backend as UID 0. Add only an explicitly mapped
# backend UID here if the container is changed to a non-root user.
CEPH_AGENT_ALLOWED_UIDS=0

CEPH_AGENT_COMMAND_TIMEOUT_SECONDS=15
CEPH_AGENT_CLIENT_TIMEOUT_SECONDS=10
CEPH_AGENT_MAX_COMMAND_OUTPUT_BYTES=4194304
CEPH_AGENT_MAX_REQUEST_BYTES=65536
CEPH_AGENT_MAX_RESPONSE_BYTES=5242880
CEPH_AGENT_MAX_CONNECTIONS=16

